# Data plane. "mock" (default) runs the demo console on in-repo sample data.
# "live" sends adapter calls to HEIMDALL_API_BASE_URL + /api/v1/... and only
# makes sense once the Heimdall backend is reachable from this deployment.
NEXT_PUBLIC_HEIMDALL_DATA_PLANE=mock

# Base URL of the Heimdall backend. Empty = same-origin /api/v1 stub routes.
# NEXT_PUBLIC_HEIMDALL_API_BASE_URL=https://api.soc.ragnarok.com

# Playwright
# E2E_PORT=3100
# E2E_BASE_URL=http://127.0.0.1:3100
